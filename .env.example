# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================

# Option 1: Local PostgreSQL (default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"

# Option 2: Free Cloud Database (Neon / Supabase)
# Sign up at https://neon.tech or https://supabase.com to get a free database URL:
# DATABASE_URL="postgresql://neondb_owner:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Application Environment
# ==============================================================================
NODE_ENV="development"
